<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.oa.calendar.mapper.OaScheduleEventMapper">

    <resultMap type="OaScheduleEvent" id="OaScheduleEventResult">
        <result property="eventId"     column="event_id"     />
        <result property="title"       column="title"       />
        <result property="eventDate"   column="event_date"   />
        <result property="startTime"   column="start_time"   />
        <result property="endTime"     column="end_time"     />
        <result property="location"    column="location"    />
        <result property="eventType"   column="event_type"   />
        <result property="createById"  column="create_by_id" />
        <result property="participants" column="participants" />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
    </resultMap>

    <sql id="selectOaScheduleEventVo">
        select event_id, title, event_date, start_time, end_time, location, event_type,
               create_by_id, participants
        from schedule_event
    </sql>

    <select id="selectOaScheduleEventList" parameterType="OaScheduleEvent" resultMap="OaScheduleEventResult">
        <include refid="selectOaScheduleEventVo"/>
        <where>
            <if test="title != null and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="eventDate != null"> and DATE_FORMAT(event_date, '%Y-%m') = DATE_FORMAT(#{eventDate}, '%Y-%m')</if>
            <if test="eventType != null and eventType != ''"> and event_type = #{eventType}</if>
            <if test="createById != null"> and create_by_id = #{createById}</if>
        </where>
        order by event_date, start_time
    </select>

    <select id="selectOaScheduleEventById" parameterType="Long" resultMap="OaScheduleEventResult">
        <include refid="selectOaScheduleEventVo"/>
        where event_id = #{eventId}
    </select>

    <insert id="insertOaScheduleEvent" parameterType="OaScheduleEvent" useGeneratedKeys="true" keyProperty="eventId">
        insert into schedule_event
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">title,</if>
            <if test="eventDate != null">event_date,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="location != null">location,</if>
            <if test="eventType != null">event_type,</if>
            <if test="createById != null">create_by_id,</if>
            <if test="participants != null">participants,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null">#{title},</if>
            <if test="eventDate != null">#{eventDate},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="location != null">#{location},</if>
            <if test="eventType != null">#{eventType},</if>
            <if test="createById != null">#{createById},</if>
            <if test="participants != null">#{participants},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateOaScheduleEvent" parameterType="OaScheduleEvent">
        update schedule_event
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null">title = #{title},</if>
            <if test="eventDate != null">event_date = #{eventDate},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="location != null">location = #{location},</if>
            <if test="eventType != null">event_type = #{eventType},</if>
            <if test="participants != null">participants = #{participants},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where event_id = #{eventId}
    </update>

    <delete id="deleteOaScheduleEventById" parameterType="Long">
        delete from schedule_event where event_id = #{eventId}
    </delete>

    <delete id="deleteOaScheduleEventByIds" parameterType="String">
        delete from schedule_event where event_id in
        <foreach item="eventId" collection="array" open="(" separator="," close=")">
            #{eventId}
        </foreach>
    </delete>
</mapper>